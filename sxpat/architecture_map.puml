@startuml
skinparam componentStyle uml2

package "Components (Logic Blocks)" {
    [Signal Propagation Constraints] as SP
    [Convexity and Structural Constraints] as CS
    [Optimization and Selection Constraints] as OS
    [Sensitivity Budget Constraints] as SB
    [Feasibility and Filtering Constraints] as FF
    [Penalty-based Soft Constraints] as PS
    [Multi-Partition Iteration Engine] as MPE
    [Search Space Calibration & State Management] as SSCSM
    [Symbolic Topology Management] as STM
    [Interactive & Diagnostic Tools] as IDT
}

package "Algorithms" {
    node "Connectivity-based" {
        [Algorithm 1] as A1
        [Algorithm 4] as A4
        [Algorithm 11] as A11
        [Algorithm 12] as A12
    }
    node "Sensitivity-based" {
        [Algorithm 2] as A2
        [Algorithm 3] as A3
    }
    node "Formal/Hard Feasibility" {
        [Algorithm 5] as A5
        [Algorithm 6] as A6
        [Algorithm 55] as A55
    }
    node "Heuristic" {
        [Algorithm 100] as A100
        [Algorithm 42] as A42
    }
}

' (Mapping)
SP --> A1 : Standard Cut
SP --> A55 : Symbolic Flow
SP --> A100 : Symbolic Flow

FF --> A5 : Hard Bound
FF --> A11 : Soft Penalty
FF --> A100 : Global Budget

SIA --> A1 : Local Context
SIA --> A55 : Global Context
SIA --> A100 : Global Context

OE --> A1 : Utility Max
OE --> A11 : Soft Penalty Hierarchical

MPE --> A11 : Exhaustive
MPE --> A100 : Exhaustive

@enduml