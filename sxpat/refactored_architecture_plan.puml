@startuml
skinparam componentStyle uml2
skinparam titleFontSize 20
left to right direction

title 
Refactored Architectural Plan (Target State)
end title


package "1. Execution Layer (Algorithms)" as L1 {
    node "Connectivity-based" {
        [Algorithm 1] as A1
        [Algorithm 4] as A4
        [Algorithm 11] as A11
        [Algorithm 12] as A12
    }
    node "Sensitivity-based" {
        [Algorithm 2] as A2
        [Algorithm 3] as A3
    }
    node "Formal/Hard Feasibility" {
        [Algorithm 5] as A5
        [Algorithm 6] as A6
        [Algorithm 55] as A55
    }
    node "Heuristic" {
        [Algorithm 42] as A42
        [Algorithm 100] as A100
    }
}

package "2. Orchestration Layer (Component Manager)" as L2 {
    [Component Manager] as CM
}

package "3. Component Library (Refactored Services)" as L3 {
    [Signal Propagation Constraints] as SP
    [Convexity and Structural Constraints] as CS
    [Optimization and Selection Constraints] as OS
    [Sensitivity Budget Constraints] as SB
    [Feasibility and Filtering Constraints] as FF
    [Penalty-based Soft Constraints] as PS
    [Multi-Partition Iteration Engine] as MPE
    [Search Space Calibration & State Management] as SSCSM
    [Symbolic Topology Management] as STM
    [Interactive & Diagnostic Tools] as IDT
}

' All algorithms communicate through the Manager
[Connectivity-based] --> CM
[Sensitivity-based] --> CM
[Formal/Hard Feasibility] --> CM
[Heuristic] --> CM

' Manager distributes to the refactored library
CM --> SP
CM --> CS
CM --> OS
CM --> SB
CM --> FF
CM --> PS
CM --> MPE
CM --> SSCSM
CM --> STM
CM --> IDT

@enduml