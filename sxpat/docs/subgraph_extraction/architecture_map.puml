@startuml Architecture_Map
skinparam componentStyle uml2
left to right direction

skinparam nodesep 50
skinparam Ranksep 1000
skinparam titleFontSize 25

<style>
node {
    LineColor black
    LineThickness 3.0
    BackgroundColor #D9D7B6
}
</style>

title 
    <i>Architectural Traceability Diagram</i>: Component Library to Algorithm Mapping
end title

package "Component Library" #D9D7B6 {
    [Signal Propagation Constraints] as SP
    [Convexity and Structural Constraints] as CS
    [Optimization and Selection Constraints] as OS
    [Sensitivity Budget Constraints] as SB
    [Feasibility and Filtering Constraints] as FF
    [Penalty-based Soft Constraints] as PS
    [Multi-Partition Iteration Engine] as MPE
    [Search Space Calibration & State Management] as SSCSM
    [Symbolic Topology Management] as STM
    [Interactive & Diagnostic Tools] as IDT
}

package "Algorithms" {
    package "Connectivity-based" #D9D7B6{
        [Algorithm 1] as A1
        [Algorithm 4] as A4
        [Algorithm 11] as A11
        [Algorithm 12] as A12
    }
    package "Sensitivity-based" #D9D7B6{
        [Algorithm 2] as A2
        [Algorithm 3] as A3
    }
    package "Formal/Hard Feasibility" #D9D7B6{
        [Algorithm 5] as A5
        [Algorithm 6] as A6
        [Algorithm 55] as A55
    }
    package "Heuristic" #D9D7B6{
        [Algorithm 42] as A42
        [Algorithm 100] as A100
    }
}

' (Mapping)
' mapping dependencies for 'Signal Propagation Constraints'
A1 --> SP
A2 --> SP
A3 --> SP
A4 --> SP
A5 --> SP
A11 --> SP
A12 --> SP

' mapping dependencies for 'Convexity and Structural Constraints'
A1 --> CS
A2 --> CS
A3 --> CS
A4 --> CS
A5 --> CS
A11 --> CS
A12 --> CS

' mapping dependencies for 'Optimization and Selection Constraints'
A1 --> OS
A2 --> OS
A3 --> OS
A4 --> OS
A5 --> OS
A11 --> OS
A12 --> OS

' mapping dependencies for 'Sensitivity Budget Constraints'
A1 --> SB
A2 --> SB
A3 --> SB

' mapping dependencies for 'Feasibility and Filtering Constraints'
A4 --> FF
A5 --> FF
A11 --> FF
A12 --> FF

' mapping dependencies for 'Penalty-based Soft Constraints'
A11 --> PS
A12 --> PS

' mapping dependencies for 'Multi-Partition Iteration Engine'
A11 --> MPE
A12 --> MPE

' mapping dependencies for 'Search Space Calibration & State Management'
A6 --> SSCSM

' mapping dependencies for 'Symbolic Topology Management'
A55 --> STM
A100 --> STM
A6 --> A55

' mapping dependencies for 'Interactive & Diagnostic Tools'
A42 --> IDT

@enduml