@startuml refactored_architecture_map
skinparam componentStyle uml2
skinparam titleFontSize 20
left to right direction

title 
Refactored Architectural Plan (Target State)
end title

package "1. Execution Layer (Algorithms)" {
    package "Connectivity-based" #D9D7B6 {
        [Algorithm 1] as A1
        [Algorithm 4] as A4
        [Algorithm 11] as A11
        [Algorithm 12] as A12
    }
    package "Sensitivity-based" #D9D7B6 {
        [Algorithm 2] as A2
        [Algorithm 3] as A3
    }
    package "Formal/Hard Feasibility" #D9D7B6 {
        [Algorithm 5] as A5
        [Algorithm 6] as A6
        [Algorithm 55] as A55
    }
}

package "2. Orchestration Layer (Component Manager)" #D9D7B6 {
    [Component Manager] as CM
}

package "3. Component Library (Refactored Services)" #D9D7B6 {
    [Signal Propagation Constraints] as SP
    [Convexity and Structural Constraints] as CS
    [Optimization and Selection Constraints] as OS
    [Sensitivity Budget Constraints] as SB
    [Feasibility and Filtering Constraints] as FF
    [Penalty-based Soft Constraints] as PS
    [Multi-Partition Iteration Engine] as MPE
    [Bitvector Topology Management] as BTM
}

' All algorithms communicate through the Manager
CM <-- [Connectivity-based] 
CM <-- [Sensitivity-based] 
CM <-- [Formal/Hard Feasibility] 

' Manager distributes to the refactored library
SP <-- CM
CS <-- CM
OS <-- CM
SB <-- CM
FF <-- CM
PS <-- CM
MPE <-- CM
BTM <-- CM

@enduml